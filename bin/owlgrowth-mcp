#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
data_dir=${OWL_GROWTH_DATA_DIR:-"$PWD/.owlgrowth"}
case "$data_dir" in
  /*) ;;
  *) data_dir="$PWD/$data_dir" ;;
esac
mkdir -p "$data_dir"

lock_file="$data_dir/.owlgrowth.lock"
lock_token="$data_dir/.owlgrowth.lock.$$"
lock_acquired=0
awk_pid=""
cleanup() {
    rm -f "$lock_token"
    if [ "$lock_acquired" -eq 1 ]; then
        lock_owner=""
        IFS= read -r lock_owner < "$lock_file" || lock_owner=""
        if [ "$lock_owner" = "$$" ]; then rm -f "$lock_file"; fi
    fi
}
terminate() {
    status="$1"
    if [ -n "$awk_pid" ]; then kill -TERM "$awk_pid" 2>/dev/null || true; fi
    exit "$status"
}
trap cleanup EXIT
trap 'terminate 129' HUP
trap 'terminate 130' INT
trap 'terminate 143' TERM
printf '%s\n' "$$" > "$lock_token"
while ! ln "$lock_token" "$lock_file" 2>/dev/null; do
    if [ -r "$lock_file" ]; then
        lock_owner=""
        IFS= read -r lock_owner < "$lock_file" || lock_owner=""
        case "$lock_owner" in
            0|''|*[!0-9]*) rm -f "$lock_file" ;;
            *) if ! kill -0 "$lock_owner" 2>/dev/null; then rm -f "$lock_file" "$data_dir/.owlgrowth.lock.$lock_owner"; fi ;;
        esac
    fi
    sleep 1
done
lock_acquired=1

exec 3<&0
LC_ALL=C awk -v data_dir="$data_dir" -f "$script_dir/owlgrowth-mcp.awk" <&3 &
awk_pid="$!"
exec 3<&-
if wait "$awk_pid"; then status=0; else status="$?"; fi
awk_pid=""
exit "$status"
