#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
data_dir=${OWL_GROWTH_DATA_DIR:-"$PWD/.owlgrowth"}
case "$data_dir" in
  /*) ;;
  *) data_dir="$PWD/$data_dir" ;;
esac
mkdir -p "$data_dir"

lock_file="$data_dir/.owlgrowth.lock"
lock_token="$data_dir/.owlgrowth.lock.$$"
cleanup() {
    rm -f "$lock_token" "$lock_file"
}
trap cleanup EXIT HUP INT TERM
printf '%s\n' "$$" > "$lock_token"
while ! ln "$lock_token" "$lock_file" 2>/dev/null; do
    if [ -r "$lock_file" ]; then
        lock_owner=""
        IFS= read -r lock_owner < "$lock_file" || lock_owner=""
        if [ -n "$lock_owner" ] && ! kill -0 "$lock_owner" 2>/dev/null; then
            rm -f "$lock_file"
        fi
    fi
    sleep 1
done
rm -f "$lock_token"

awk -v data_dir="$data_dir" -f "$script_dir/owlgrowth-mcp.awk"
